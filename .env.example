# Copier en .env pour surcharger la config par défaut (SQLite local).
# docker-compose définit déjà DATABASE_URL pour pointer vers son service postgres.
DATABASE_URL=postgresql://afririsk:afririsk@localhost:5432/afririsk

# Clé de signature des jetons JWT (voir docs/auth.md). Une valeur par défaut
# de développement est utilisée si absente — À CHANGER en production
# (ex. openssl rand -hex 32), sous peine de permettre la forge de jetons.
JWT_SECRET_KEY=change-me-in-production
